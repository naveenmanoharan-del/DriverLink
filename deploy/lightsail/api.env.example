# API settings on the Lightsail server. setup.sh copies this to backend/.env,
# fills in the domain and generates the JWT secrets. Fill in the blanks.

PORT=3000

# Lightsail database -> Connect: user "dbmasteruser", the endpoint, port 5432.
# Keep the database's public mode OFF; the instance reaches it privately.
# Do NOT append ?sslmode=require (see src/database/ssl.ts).
DATABASE_URL=postgresql://dbmasteruser:<password>@<endpoint>:5432/<database-name>
DATABASE_CA_CERT_FILE=certs/rds-global-bundle.pem

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=naveenmanoharan@yuktisolutions.co.in
MAIL_FROM=Yukti Solutions <onboarding@resend.dev>

# First admin; created on the first deploy if no account has this phone.
ADMIN_PHONE=
ADMIN_PASSWORD=

CORS_ORIGIN=https://__DOMAIN__,https://www.__DOMAIN__
REQUEST_LOGGING=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60
