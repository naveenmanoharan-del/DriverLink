PORT=3000
DATABASE_URL=postgresql://manpower:manpower_local@localhost:5433/manpower_db
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=7d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=*

# Global API rate limit (per client IP): RATE_LIMIT_LIMIT requests per RATE_LIMIT_TTL_MS.
# Auth endpoints (register/login/refresh) use their own tighter, hardcoded limits — see auth.controller.ts.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60
