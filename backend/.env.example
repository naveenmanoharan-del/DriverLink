PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Docker Compose Postgres:
DATABASE_URL=postgresql://manpower:manpower_local@localhost:5433/manpower_db
#
# Hosted Postgres (Supabase / Neon): paste the connection string from the
# provider. TLS is turned on automatically for any non-localhost host.
#
# Supabase gives you more than one connection string — the choice matters:
#   * Session pooler / direct connection (port 5432) — use this. The API is a
#     long-lived Node process, and `npm run db:migrate` REQUIRES it.
#   * Transaction pooler (port 6543, pgBouncer) — do NOT use it here. It breaks
#     DDL and prepared statements, so migrations fail against it.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate real values before deploying — anything predictable lets an attacker
# mint their own tokens:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=7d

# ---------------------------------------------------------------------------
# Email notifications (new sign-ups and resumes) — via resend.com's HTTP API.
# Leave RESEND_API_KEY blank locally to skip sending; a warning is logged.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=naveenmanoharan@yuktisolutions.co.in
MAIL_FROM=Yukti Solutions <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# First admin account — created by the migrate step (npm run start:prod or
# npm run db:migrate:app) if no account has this phone yet. Log in at /login.
# ADMIN_RESET_PASSWORD=true resets an existing admin's password to this value.
# ---------------------------------------------------------------------------
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_RESET_PASSWORD=

# Provisioned for future use (queues, caching). Nothing reads it yet.
REDIS_URL=redis://localhost:6379

# Comma-separated origins allowed to call the API. `*` is fine locally; set it
# to the real web origin in production.
CORS_ORIGIN=*

# Set to true to log one line per request (method, path, status, duration).
# No bodies or headers are logged.
REQUEST_LOGGING=false

# Global API rate limit (per client IP): RATE_LIMIT_LIMIT requests per RATE_LIMIT_TTL_MS.
# Auth endpoints (register/login/refresh) use their own tighter, hardcoded limits — see auth.controller.ts.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60
